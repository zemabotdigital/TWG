# Travel With Guru — frontend-only site.
# There is no database. These are the only variables the site reads.

# Published business number for WhatsApp click-to-chat (digits only, country
# code, no plus). NEXT_PUBLIC_ is correct: wa.me links appear in the page
# source by nature. This is a published number, not a secret.
NEXT_PUBLIC_WHATSAPP_NUMBER="919446084555"

# Canonical site URL, used for social-card metadata.
# Optional on Vercel — it falls back to the deployment URL automatically.
NEXT_PUBLIC_SITE_URL="https://travelwithguru.example"
