# Copy to .env and fill in.
DATABASE_URL="file:./dev.db"

# Signs the admin session cookie. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Only read by the seed script, to create the first admin account.
ADMIN_EMAIL="admin@travelwithguru.org"
ADMIN_PASSWORD=""

# ── WhatsApp ────────────────────────────────────────────────────────
# Published business number, digits only with country code, no plus.
# NEXT_PUBLIC_ is correct here: wa.me links are visible in the page source
# by nature. This is a published number, not a secret.
NEXT_PUBLIC_WHATSAPP_NUMBER="919446084555"

# ── Automation platform (server-side only, never NEXT_PUBLIC_) ──────
# Where appointment requests are POSTed. Blank = deliveries are SKIPPED
# and recorded as such; requests are still saved and visible in /admin.
AUTOMATION_WEBHOOK_URL=""
# Sent as the x-twg-signature header so the platform can reject forgeries.
AUTOMATION_WEBHOOK_SECRET=""
